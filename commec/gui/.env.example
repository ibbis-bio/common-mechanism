# commec-gui configuration. Copy to .env and edit for this machine.
# Values are sourced by kiosk.sh, so quote anything containing spaces.

# Database directory: passed to `commec screen` and prefilled in the form.
COMMEC_DB_DIR="/path/to/commec/databases"

# Conda environment that has commec + flask installed.
COMMEC_CONDA_ENV="commec-dev"

# Port the server listens on. Default 443 (clean https URL, no port to type).
# 443 is privileged: the unprivileged server needs a bind grant on the host
# (see deploy-notes.md "Privileged port"). Use a high port like 8765 if you
# can't/don't want to grant it.
COMMEC_GUI_PORT="443"

# CPU threads passed to commec's search tools (-t). Leave unset to use all
# logical cores (one screen runs at a time, so the kiosk is dedicated to it).
# COMMEC_GUI_THREADS="12"

# Access-password hash file. If it exists and is non-empty, non-localhost
# clients must log in (the walk-up kiosk on 127.0.0.1 is exempt). Default:
# ~/.config/commec-gui/password.hash. Set this to relocate it. Create/update
# the hash with:
#   python -c 'from werkzeug.security import generate_password_hash as h; \
#     import getpass; print(h(getpass.getpass()))' > ~/.config/commec-gui/password.hash
# COMMEC_GUI_PASSWORD_FILE="/home/kiosk/.config/commec-gui/password.hash"

# TLS for LAN mode (lan.sh). By default lan.sh serves HTTPS, auto-generating
# certs/server.{crt,key} on first startup (mkcert if available, else openssl).
#   - Set COMMEC_TLS=0 to force plain HTTP.
#   - Or point these at your own cert/key pair to use it instead of auto-gen.
# COMMEC_TLS=0
COMMEC_TLS_CERT=""
COMMEC_TLS_KEY=""
